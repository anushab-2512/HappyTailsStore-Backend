# Environment variables required by the backend.
# Set these in Railway -> Variables (name/value pairs). No defaults are
# hardcoded in application.properties, so all of these are required in production.
#
# Database (MySQL on Railway):
SPRING_DATASOURCE_URL=jdbc:mysql://host:port/database
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# JWT signing secret (at least 256 bits / 32+ characters) and expiry in ms:
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MS=86400000

# Razorpay API keys:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
